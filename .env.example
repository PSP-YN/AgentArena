# Local Bifrost gateway root URL
BIFROST_BASE_URL=http://localhost:8080
# Optional key used for inference if gateway auth is enabled
BIFROST_API_KEY=
# Optional Bifrost management API key with Logs:View permission; used for observed USD cost
BIFROST_LOGS_API_KEY=
# REQUIRED for public deployments that allow benchmark/inference POST requests.
# Generate a strong random secret and store it in your hosting provider's secret manager.
# Leave unset only for local development.
AGENTARENA_API_KEY=
