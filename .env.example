# AgentArena API protection (set a long random value on public deployments)
AGENTARENA_API_KEY=

# Durable run history: use a managed PostgreSQL URL in hosted deployments.
# Do not rely on SQLite/local files for Vercel or other ephemeral serverless runtimes.
DATABASE_URL=
# Set true in hosted production to refuse inference if durable storage is not configured.
AGENTARENA_REQUIRE_DATABASE=false

BIFROST_BASE_URL=http://localhost:8080
BIFROST_API_KEY=
BIFROST_LOGS_API_KEY=
